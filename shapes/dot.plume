use #rawNumbers

let Tag from $import(html)
let Vect2D  from $import(../cls/Vect2D)
let Shape   from $import(../cls/shape)
let SvgPath from $import(../utils)

Dot: macro(Vect2D pos, String label:, Number angle: $(-Math.pi/2), ?cross, ?deg)
	if not label and not cross
		raise Empty dot
	end

	if deg
		set angle *= $ Math.pi / 180
	end

	macro textOffset(angle, style)
		$ Vect2D(a: angle, r: style.text.offset)
	end

	@Shape
		render: macro(pos, style:)
			let _textOffset = $ textOffset(angle, style)
			@Tag(text)
				x: $pos.x
				y: $pos.y
				transform: translate($_textOffset.x, $_textOffset.y)
				...style.font
				- $label
			end

			if cross
				let d = $ style.dot.length/2

				let tl = $ pos + Vect2D(-d, -d)
				let tr = $ pos + Vect2D(d, -d)
				let bl = $ pos + Vect2D(-d, d)
				let br = $ pos + Vect2D(d, d)

				@SvgPath(...style.stroke)
					M $tl.x $tl.y
					L $br.x $br.y
					M $tr.x $tr.y
					L $bl.x $bl.y
				end
			end
		end
		// Magic values
		deco: macro(pos, style:)
			set pos += $ textOffset(angle, style)
			minX: $ pos.x - 1 * 20
			maxX: $ pos.x + len(label) * 20
			minY: $ pos.y - 1 * 20
			maxY: $ pos.y + 3 * 20
		end
		definition: do
			- $pos
		end
	end
end