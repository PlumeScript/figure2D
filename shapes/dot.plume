use #rawNumbers

let Tag from $import(html)
let Vect2D  from $import(../cls/Vect2D)
let Shape   from $import(../cls/shape)
let SvgPath from $import(../utils)

Dot: macro(Vect2D pos, String label:, Number angle: $(-Math.pi/2), Number direction: 0, style:, ?cross, ?deg)
	if not label and not cross
		raise Empty dot
	end

	if deg
		set angle *= $ Math.pi / 180
	else
		set direction /= $ Math.pi / 180
	end

	macro textOffset(angle, style)
		$ Vect2D(a: angle, r: style.text.offset)
	end

	@Shape
		style: $style
		render: macro(pos, style:)
			let _textOffset = $ textOffset(angle, style)
			@Tag(text)
				x: $pos.x
				y: $pos.y
				transform: do
					rotate($direction 50 50) translate($_textOffset.x, $_textOffset.y)
				end
				...style.font
				- $label
			end

			if cross
				let d = $ style.dot.length/2

				let tl = $ pos + Vect2D(-d, -d)
				let tr = $ pos + Vect2D(d, -d)
				let bl = $ pos + Vect2D(-d, d)
				let br = $ pos + Vect2D(d, d)

				@SvgPath(...style.stroke)
					M $tl.x $tl.y
					L $br.x $br.y
					M $tr.x $tr.y
					L $bl.x $bl.y
				end
			end
		end
		// Label extent box, in 100-box units. textAnchor is middle and
		// dominantBaseline is central: the text is centered on the offset
		// position. Font size in units ~ style.text.offset (both are
		// context values / p). 0.35 = half-width per char (proportional
		// font, ~0.7em per char with margin), 0.6 = half-height.
		deco: macro(pos, style:)
			let off = $ textOffset(angle, style)
			let w = $ 0.35 * style.text.offset * len(label)
			let h = $ 0.6 * style.text.offset
			let minX = $ pos.x + off.x - w
			let maxX = $ pos.x + off.x + w
			let minY = $ pos.y + off.y - h
			let maxY = $ pos.y + off.y + h
			if cross
				let d = $ style.dot.length / 2
				set minX = $ min(minX, pos.x - d)
				set maxX = $ max(maxX, pos.x + d)
				set minY = $ min(minY, pos.y - d)
				set maxY = $ max(maxY, pos.y + d)
			end
			minX: $minX
			maxX: $maxX
			minY: $minY
			maxY: $maxY
		end
		definition: do
			- $pos
		end
	end
end