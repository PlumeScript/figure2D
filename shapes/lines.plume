use #rawNumbers

let Vect2D  from $import(../cls/Vect2D)
let Shape   from $import(../cls/shape)
let SvgPath from $import(../utils)

Line: macro(Vect2D u, Vect2D v)
	if u == v
		raise `u` and `v` must be differents.
	end

	@Shape
		render: macro(u, v, style:)
			// Should compute intersection with border
			let ru = $ u + (v-u).normalize()*2000
			let rv = $ u - (v-u).normalize()*2000
			 @SvgPath(...style.stroke)
				M $ru.x $ru.y\s
				L $rv.x $rv.y
			end
		end
		definition: do
			- $u
			- $v
		end
	end
end

HalfLine: macro(Vect2D u, Vect2D v)
	if u == v
		raise `u` and `v` must be differents.
	end

	@Shape
		render: macro(u, v, style:)
			// Should compute intersection with border
			let rv = $ u + (v-u).normalize()*2000
			 @SvgPath(...style.stroke)
				M $u.x $u.y\s
				L $rv.x $rv.y
			end
		end
		definition: do
			- $u
			- $v
		end
	end
end

Segment: macro(Vect2D u, Vect2D v)
	if u == v
		raise `u` and `v` must be differents.
	end

	@Shape
		render: macro(u, v, style:)
			 @SvgPath(...style.stroke)
				M $u.x $u.y\s
				L $v.x $v.y
			end
		end
		definition: do
			- $u
			- $v
		end
	end
end
