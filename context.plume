strokeWidth: $Context(1.5px)
stroke: $Context(black)
strokeLinecap: $Context(round)
vectorEffect: $Context(non-scaling-stroke)

fontSize: $Context(2em)
fontFamily: $Context(var(--font-title))
textAnchor: $Context(middle)
dominantBaseline: $Context(central)
textOffset: $Context(25)

dotLength: $Context(15)