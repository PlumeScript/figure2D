use #rawNumbers

let Vect2D  from $import(../cls/Vect2D)
let context = $import(../context)

Shape: macro(render:, definition:, box:)
	render: macro(cx, cy, scale, style)
		@render
			style: $style
			for dot in definition
				let x = $dot.x
				let y = $dot.y
				
				- @Vect2D
					x: $ 100 * (x - cx) * scale + 50
					y: $ 100 * (y - cy) * scale + 50
				end
			end
		end
	end
	// (minX, minY, maxX, maxY)
	box: if box
		...box
	else
		let minX = $ Math.huge
		let maxX = $ Math.huge * -1
		let minY = $ Math.huge
		let maxY = $ Math.huge * -1

		for dot in definition
			set minX = $ min(minX, dot.x)
			set maxX = $ max(maxX, dot.x)
			set minY = $ min(minY, dot.y)
			set maxY = $ max(maxY, dot.y)
		end

		minX: $minX
		minY: $minY
		maxX: $maxX	
		maxY: $maxY
	end
end