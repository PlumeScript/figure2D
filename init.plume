use #rawNumbers

let Vect2D  from $import(./cls/Vect2D)

for file in os.Path("./shapes").getChildren()
	...file.import()
end
let context = $import(./context)

Vect2D: $Vect2D
Canva2D: macro(Number width: 100, Number height: 100, ...elems)
	let margin = $context.margin()

	if len(elems)>0
		let minX = $ Math.huge
		let maxX = $ Math.huge * -1
		let minY = $ Math.huge
		let maxY = $ Math.huge * -1

		for elem in elems
			set minX = $ min(minX, elem.box.minX)
			set maxX = $ max(maxX, elem.box.maxX)
			set minY = $ min(minY, elem.box.minY)
			set maxY = $ max(maxY, elem.box.maxY)
		end

		if minX == Math.huge
			set minX = -10
		end
		if minY == Math.huge
			set minY = -10
		end
		if maxX == -Math.huge
			set maxX = 10
		end
		if maxY == -Math.huge
			set maxY = 10
		end

		if minX == maxX
			set minX -= 1
			set maxX += 1
		end
		if minY == maxY
			set minY -= 1
			set maxY += 1
		end

		let scale = $ 1 /  max(maxX - minX, maxY - minY)
		if scale == 0
			raise Infinite box
		end
		let p = $ min(width, height) / (100 + 2*margin)

		let style = do
			stroke: do
				strokeWidth: $context.strokeWidth()
				stroke: $context.stroke()
				strokeLinecap: $context.strokeLinecap()
				vectorEffect: $context.vectorEffect()
			end
			font: do
				fontSize: calc($context.fontSize() / $p)
				fontFamily: $context.fontFamily()
				textAnchor: $context.textAnchor()
				dominantBaseline: $context.dominantBaseline()
			end
			text: do
				offset: $ context.textOffset() / p
			end
			dot: do
				length: $ context.dotLength() / p
			end
		end

		let box = do
			minX: $ -margin
			minY: $ -margin
			maxX: $ 100+2*margin
			maxY: $ 100+2*margin
		end

		let content = for elem in elems
			let svg, deco from $ elem.render((minX+maxX)/2, (minY+maxY)/2, scale, style)
			$svg

			if deco
				if deco.minX < box.minX
					set box.minX = $ deco.minX
				end
				if deco.minY < box.minY
					set box.minY = $ deco.minY
				end
				if deco.maxX > box.maxX
					set box.maxX = $ deco.maxX
				end
				if deco.maxY > box.maxY
					set box.maxY = $ deco.maxY
				end
			end
		end

		<svg\s
			viewBox="$box.minX $box.minY $box.maxX $box.maxY"\s
			xmlns="http\:\//www.w3.org/2000/svg"\s
			width="$width"\s
			height="$height"\s
		>
			$content
		</svg>
	else
		$plume.warning(Empty canva.)
	end
end